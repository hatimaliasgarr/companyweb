# Zerobugg — environment variables
# Copy to .env (or .env.local) and fill in what you need:  cp .env.example .env
# Every value below is optional: the site builds and runs with none of them set.
# .env* is git-ignored, so real values never get committed.

# --- Production server (server.mjs / Dockerfile / docker-compose.yml) ---
# Port the built site listens on. Default: 3000
PORT=3000
# Interface to bind. Keep 0.0.0.0 in Docker so the container accepts traffic. Default: 0.0.0.0
HOST=0.0.0.0
# Set by the Dockerfile; only set it yourself when running `node server.mjs` directly.
NODE_ENV=production

# --- SEO ---
# Google Search Console verification token (the content="..." value of its meta tag).
# Leave empty to omit the tag entirely.
GOOGLE_SITE_VERIFICATION=

# --- Notes ---
# Cloudflare Workers: ASSETS, DB and IMAGES are service bindings, not variables here.
# They are configured in .openai/hosting.json and the Cloudflare dashboard.
# Build-tool vars (WRANGLER_WRITE_LOGS, WRANGLER_LOG_PATH, MINIFLARE_REGISTRY_PATH,
# CODEX_SANDBOX, NEXT_TELEMETRY_DISABLED) are set automatically; don't set them here.
# The contact form posts to /api/contact and needs the Gmail values below.

# --- Contact form email delivery (required for /api/contact) ---
# Gmail account that authenticates with SMTP and appears in the From header.
GMAIL_USER=
# Google App Password for that account (16 characters, spaces optional).
# Never the normal Gmail password, and never committed to Git.
GMAIL_APP_PASSWORD=
# Inquiries are always delivered to office@zerobugg.in (see app/lib/contact-inquiry.ts).
